APP_NAME="AushadhiChain"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pharmacy
# DB_USERNAME=pharmacy
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail / SMS
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@aushadhichain.test"
MAIL_FROM_NAME="${APP_NAME}"
SMS_PROVIDER=log
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
SSLWIRELESS_API_TOKEN=
SSLWIRELESS_SID=

# Demo mode
DEMO_MODE=true
DEMO_TENANT_SLUG=demo-pharma-chain
DEMO_PASSWORD=password

# Payments
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_HUB_DEFAULT_PROVIDER=openai
AI_HUB_LOG_REQUESTS=true
AI_CATALOG_ENABLED=true

# Attendance devices
ATTENDANCE_HUB_DRIVER=log
ZKTECO_IP=
ZKTECO_PORT=4370

# Scraping / catalog enrichment
SCRAPING_ENABLED=false
SCRAPING_PROXY_URL=

# Drutogoti analytics
DRUTOGOTI_ENABLED=false
DRUTOGOTI_PROJECT_KEY=
DRUTOGOTI_INGEST_URL=

# Sanctum / API
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

VITE_APP_NAME="${APP_NAME}"
